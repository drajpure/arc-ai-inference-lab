# Environment variables for Foundry Local on OCP via Arc Extension.
# Copy this file to env.sh and fill in your values.
# Source it before running scripts: source env.sh

# === Azure Identity ===
# These are informational — scripts derive the active sub/tenant from `az account show`.
# Set them so `az account set --subscription "$AZURE_SUBSCRIPTION_ID"` works in your shell.
export AZURE_SUBSCRIPTION_ID=""          # Your Azure subscription
export AZURE_TENANT_ID=""                # Entra ID tenant
export AZURE_REGION="eastus"             # Must be a Foundry Local supported region

# === OCP Cluster (already provisioned) ===
# Skip Stage A provisioning — Arc Extension path assumes an existing OCP cluster.
export CLUSTER_NAME=""                   # OCP cluster name
export KUBECONFIG="./kubeconfig"         # Path to OCP kubeconfig

# === Azure Arc Onboarding (used by 01a-prep-arc-azure.sh and 01b-connect-arc.sh) ===
export ARC_RESOURCE_GROUP=""             # Azure RG for the Arc connectedCluster resource
export ARC_CLUSTER_NAME=""               # Name for the Arc connectedCluster resource

# === Foundry Local (shared with Helm-based scripts) ===
export MODEL_ALIAS="qwen2.5-coder-0.5b"  # Model to deploy for validation (smallest CPU model)
export NAMESPACE="foundry-local-operator" # Foundry operator namespace

# === Arc Extension Settings (used by 05-install-extension.sh) ===
export EXTENSION_NAME="foundrylocal"     # Extension instance name (determines SA prefix)
export EXTENSION_TYPE="microsoft.foundry" # Extension type (do NOT change)

# === Entra ID Auth (used by 05-install-extension.sh and 09-configure-entra-auth.sh) ===
# If ENTRA_APP_CLIENT_ID is set, the extension installs with Entra auth enabled.
# If empty, Entra auth is disabled and only API key auth is available.
# Run 09-configure-entra-auth.sh to create the app registration, or set manually.
export ENTRA_APP_CLIENT_ID=""                     # Entra app client ID (enables Bearer token auth)
export ENTRA_TENANT_ID=""                         # Entra tenant ID (defaults to AZURE_TENANT_ID if empty)
export ENTRA_APP_NAME="FoundryLocal-Production"   # Entra app display name (script creates it if missing)
export ENTRA_APP_ID_URI=""                        # api://<client-id> (auto-set by 09-configure-entra-auth.sh)

# Optional: grantees for RBAC role assignments. Leave blank to skip and assign later.
export ENTRA_USER_OR_GROUP_OBJECT_ID=""           # Object ID of user/group needing inference access (Step 5)
export ENTRA_USER_ROLE="Cognitive Services OpenAI User"  # or "Cognitive Services Contributor"
export ENTRA_MSI_OBJECT_ID=""                     # Object ID of managed identity / SP (Step 7, optional)

# === Storage Workaround (used by 04-prep-storage.sh) ===
# If Azure Disk CSI (managed-csi) works on your cluster, set USE_LOCAL_STORAGE="false".
# If CSI is broken (credentialsMode: Manual without seeded secret), set to "true".
export USE_LOCAL_STORAGE="true"          # "true" = swap default SC to local-storage
export LOCAL_PV_NODE=""                  # Node hostname for PV (run: kubectl get nodes -o name | head -1)
export LOCAL_PV_PATH="/var/foundry-models"  # Host path for model cache
