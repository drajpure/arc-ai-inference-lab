# Environment variables for Foundry Local on OCP deployment.
# Copy this file to env.sh and fill in your values.
# Source it before running scripts: source env.sh

# === Azure Identity ===
export AZURE_SUBSCRIPTION_ID=""          # Your Azure subscription
export AZURE_TENANT_ID=""                # Entra ID tenant
export AZURE_REGION="eastus"             # Must be a Foundry Local supported region

# === OCP Cluster ===
export CLUSTER_NAME="ocp-foundry-test"   # OCP cluster name
export BASE_DOMAIN="example.com"         # DNS base domain for OCP
export RESOURCE_GROUP="rg-ocp-foundry"   # Azure resource group
export PULL_SECRET_FILE=".pull-secret.txt"  # Red Hat pull secret path

# === Kubeconfig ===
export KUBECONFIG="./kubeconfig"         # Path to kubeconfig after provisioning

# === Arc ===
export ARC_CLUSTER_NAME="ocp-foundry-arc"  # Name for the Arc connected cluster resource

# === Foundry Local ===
export OPERATOR_VERSION="0.260430.8"     # Inference operator Helm chart version
export STORAGE_CLASS=""                   # Empty = cluster default; "local-storage" if CSI broken
export MODEL_ALIAS="qwen2.5-coder-0.5b"  # Model to deploy for validation (smallest CPU model)
export NAMESPACE="foundry-local-operator" # Foundry operator namespace

# === cert-manager ===
export CERT_MANAGER_VERSION="v1.19.2"
export TRUST_MANAGER_VERSION="v0.20.3"
