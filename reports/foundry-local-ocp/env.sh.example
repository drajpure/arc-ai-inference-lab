# Environment variables for Foundry Local on OCP deployment.
# Copy this file to env.sh and fill in your values.
# Source it before running scripts: source env.sh

# === Azure Identity ===
# These are informational — scripts derive the active sub/tenant from `az account show`.
# Set them so `az account set --subscription "$AZURE_SUBSCRIPTION_ID"` works in your shell.
export AZURE_SUBSCRIPTION_ID=""          # Your Azure subscription
export AZURE_TENANT_ID=""                # Entra ID tenant
export AZURE_REGION="eastus"             # Must be a Foundry Local supported region

# === Phase 1: OCP Cluster (used by 00-provision-ocp.sh) ===
# Skip this section if you already have an OCP cluster.
export CLUSTER_NAME="ocp-foundry-test"           # OCP cluster name
export BASE_DOMAIN="example.com"                 # DNS base domain for OCP
export OCP_RESOURCE_GROUP="rg-ocp-dns"           # Azure RG holding the DNS zone (IPI requirement)
export PULL_SECRET_FILE=".pull-secret.txt"       # Red Hat pull secret path
export INSTALL_DIR="./install-dir"               # openshift-install working directory

# === Phase 2: Arc Azure-side Prep (used by 01-prep-arc-azure.sh) ===
# Creates the RG that will hold the Arc-connected-cluster resource, registers providers, installs az extensions.
export ARC_RESOURCE_GROUP="rg-ocp-foundry-arc"   # Azure RG for the Arc connectedCluster resource
                                                  #   (may equal OCP_RESOURCE_GROUP, but keeping them separate
                                                  #    keeps OCP infra independent from Arc lifecycle)

# === Phase 3: Connect Cluster to Arc (used by 02-connect-arc.sh) ===
export KUBECONFIG="./kubeconfig"                  # Path to OCP kubeconfig
                                                  #   - From 00: ./install-dir/auth/kubeconfig
                                                  #   - Existing cluster: point to your own kubeconfig
export ARC_CLUSTER_NAME="ocp-foundry-arc"         # Name for the Arc connectedCluster resource

# === Foundry Local (Phases 3-8) ===
export OPERATOR_VERSION="0.260430.8"     # Inference operator Helm chart version
export STORAGE_CLASS=""                   # Empty = cluster default; "local-storage" if CSI broken
export MODEL_ALIAS="qwen2.5-coder-0.5b"  # Model to deploy for validation (smallest CPU model)
export DEPLOYMENT_NAME="qwen-coder-deploy" # Name of the ModelDeployment CR (used by 07 and 08)
export NAMESPACE="foundry-local-operator" # Foundry operator namespace

# === cert-manager ===
export CERT_MANAGER_VERSION="v1.19.2"
export TRUST_MANAGER_VERSION="v0.20.3"

# === Phase D (optional): Entra ID Auth (used by 09-configure-entra-auth.sh) ===
# See: https://learn.microsoft.com/azure/azure-sovereign-clouds/private/foundry-local/how-to-configure-authentication
export ENTRA_APP_NAME="FoundryLocal-Production"   # Entra app display name (script creates it if missing)

# Optional: grantees for RBAC role assignments. Leave blank to skip and assign later.
export ENTRA_USER_OR_GROUP_OBJECT_ID=""           # Object ID of user/group needing inference access (Step 5)
export ENTRA_USER_ROLE="Cognitive Services OpenAI User"  # or "Cognitive Services Contributor"
export ENTRA_MSI_OBJECT_ID=""                     # Object ID of managed identity / SP (Step 7, optional)

# Populated by 09-configure-entra-auth.sh after first run — copy from script output:
export ENTRA_APP_CLIENT_ID=""                     # Output of Step 1
export ENTRA_TENANT_ID=""                         # Same as AZURE_TENANT_ID
export ENTRA_APP_ID_URI=""                        # api://<client-id> — used as Helm 'entraAuth.audience'
